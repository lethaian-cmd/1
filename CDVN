RunService.Heartbeat:Connect(function(dt)

    if S.TeleportActive and S.TeleTarget then
        local myC   = LP.Character
        local myHrp = myC and myC:FindFirstChild("HumanoidRootPart")
        local tC    = S.TeleTarget.Character or workspace:FindFirstChild(S.TeleTarget.Name)
        local tHrp  = tC and tC:FindFirstChild("HumanoidRootPart")
        if myHrp and tHrp then
            local tp = tHrp.Position
            if S.TeleMode == 1 then
                myHrp.CFrame = CFrame.new((tHrp.CFrame * CFrame.new(0,0,3.5)).Position, tp)
            elseif S.TeleMode == 2 then
                OrbitAngle = OrbitAngle + (S.OrbitSpeed * dt)
                if OrbitAngle > math.pi*2 then OrbitAngle = 0 end
                myHrp.CFrame = CFrame.new(tp + Vector3.new(math.cos(OrbitAngle)*S.OrbitRadius, 0, math.sin(OrbitAngle)*S.OrbitRadius), tp)
            elseif S.TeleMode == 3 then
                myHrp.CFrame = CFrame.new(tp + Vector3.new(0, -3.2, 0), tp)
            elseif S.TeleMode == 4 then
                myHrp.CFrame = CFrame.new(tp + Vector3.new(0, 5.5, 0), tp)
            end
            myHrp.Velocity = Vector3.new(0, 0, 0)
        end
    end

    if S.StandEnabled and S.MasterPlayer then
        local myC   = LP.Character
        local myHrp = myC and myC:FindFirstChild("HumanoidRootPart")
        local myHum = myC and myC:FindFirstChildOfClass("Humanoid")
        local mC    = S.MasterPlayer.Character or workspace:FindFirstChild(S.MasterPlayer.Name)
        local mHrp  = mC and mC:FindFirstChild("HumanoidRootPart")

        if myHrp and myHum and myHum.Health > 0 then
            if S.StandState == "FollowMaster" and mHrp then
                local behind = mHrp.CFrame * CFrame.new(0, 0, 3.8)
                myHrp.CFrame   = CFrame.new(behind.Position, mHrp.Position)
                myHrp.Velocity = Vector3.new(0, 0, 0)

            elseif S.StandState == "Assassinating" and S.KillTargetChar then
                local tM = S.KillTargetChar
                if not tM.Parent or not tM:FindFirstChild("HumanoidRootPart") then
                    tM = workspace:FindFirstChild(S.KillTargetChar.Name)
                    if tM then S.KillTargetChar = tM end
                end
                local kHrp = tM and tM:FindFirstChild("HumanoidRootPart")
                local kHum = tM and tM:FindFirstChildOfClass("Humanoid")

                if kHrp and kHum and kHum.Health > 0 then
                    for _, pt in pairs(myC:GetChildren()) do if pt:IsA("BasePart") then pt.CanCollide = false end end
                    StandOrbitAngle = StandOrbitAngle + (S.OrbitSpeed * dt)
                    if StandOrbitAngle > math.pi*2 then StandOrbitAngle = 0 end
                    local op = kHrp.Position + Vector3.new(math.cos(StandOrbitAngle)*S.OrbitRadius, 0, math.sin(StandOrbitAngle)*S.OrbitRadius)
                    myHrp.CFrame      = CFrame.new(op, kHrp.Position)
                    myHrp.Velocity    = Vector3.new(0, 0, 0)
                    myHrp.RotVelocity = Vector3.new(0, 0, 0)
                    local tool = myC:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
                    if tool then
                        if tool.Parent ~= myC then pcall(function() myHum:EquipTool(tool) end)
                        else pcall(function() tool:Activate() end) end
                    end
                else
                    for _, pt in pairs(myC:GetChildren()) do if pt:IsA("BasePart") then pt.CanCollide = true end end
                    S.StandState = "FollowMaster"; S.KillTargetChar = nil
                    StatusLbl.Text = "Trạng thái: Đã ghim Stand"; StatusLbl.TextColor3 = Color3.fromRGB(0, 255, 160)
                    showNotif("🔮 Kẻ địch đã gục! Về hộ vệ Chủ Nhân.", Color3.fromRGB(180, 140, 255))
                end
            end
        end
    end
end)


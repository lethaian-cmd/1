mkToggle(TabMain, "💀 Siêu Hủy Đồ Họa (Max FPS)", function(state)
    S.UltraAntiLag = state
    if state then
        Lighting.GlobalShadows = false; Lighting.FogEnd = 1e9
        Lighting.Brightness = 0; Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere")
            or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Clouds")
            or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("BloomEffect") then
                v.Parent = game:GetService("TestService")
            end
        end
        local myC = LP.Character
        for _, obj in pairs(workspace:GetDescendants()) do
            if not (myC and obj:IsDescendantOf(myC)) then
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic; obj.CastShadow = false
                    obj.Reflectance = 0; obj.TopSurface = Enum.SurfaceType.Smooth; obj.BottomSurface = Enum.SurfaceType.Smooth
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    pcall(function() obj.Parent = game:GetService("TestService") end)
                elseif obj:IsA("SpecialMesh") then
                    obj.TextureId = ""
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                    obj.Enabled = false; if obj:IsA("ParticleEmitter") then obj:Clear() end
                elseif obj:IsA("Trail") or obj:IsA("Beam") then
                    obj.Enabled = false
                elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
                    obj.Enabled = false
                elseif obj:IsA("Sound") then
                    obj.Volume = 0
                elseif obj:IsA("SelectionBox") or obj:IsA("BoxHandleAdornment") then
                    obj.SurfaceTransparency = 1
                end
            end
        end
        showNotif("💀 Đã hủy TOÀN BỘ đồ họa!", Color3.fromRGB(255, 75, 75))
    else
        Lighting.GlobalShadows = true; Lighting.Brightness = 2
        for _, v in pairs(game:GetService("TestService"):GetChildren()) do
            pcall(function() v.Parent = Lighting end)
        end
        for _, obj in pairs(workspace:GetDescendants()) do
            local myC = LP.Character
            if not (myC and obj:IsDescendantOf(myC)) then
                if obj:IsA("BasePart") then obj.Material = Enum.Material.Plastic; obj.CastShadow = true end
                if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then obj.Enabled = true end
                if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then obj.Enabled = true end
            end
        end
        showNotif("✅ Đã khôi phục đồ họa.", Color3.fromRGB(180, 255, 200))
    end
end)


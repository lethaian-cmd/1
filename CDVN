local function refreshMasterDrop()
    for _, v in pairs(MasterDrop:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local cnt = 0
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            cnt = cnt + 1
            local b = Instance.new("TextButton"); b.Size = UDim2.new(1, 0, 0, 29)
            b.BackgroundColor3 = Color3.fromRGB(30, 16, 48)
            b.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            b.Font = Enum.Font.BuilderSansBold; b.TextSize = 10
            b.TextColor3 = Color3.fromRGB(225, 210, 242); b.ZIndex = 21; b.Parent = MasterDrop
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
            b.MouseButton1Click:Connect(function()
                S.MasterPlayer = p; SelectorBtn.Text = "Chủ Nhân: " .. p.Name
                StatusLbl.Text = "Trạng thái: Đã ghim Stand"; StatusLbl.TextColor3 = Color3.fromRGB(0, 255, 160)
                MasterDrop.Visible = false
                showNotif("🔮 Kết nối Stand với [" .. p.DisplayName .. "]", Color3.fromRGB(180, 140, 255))
                if ChatConn then ChatConn:Disconnect() end
                ChatConn = p.Chatted:Connect(function(msg)
                    if not S.StandEnabled then return end
                    local raw = string.gsub(string.gsub(msg, "^%s+", ""), "%s+$", "")
                    local lm  = string.lower(raw)
                    if lm == "r" then
                        S.StandState = "FollowMaster"; S.KillTargetChar = nil
                        local c = LP.Character
                        if c then for _, pt in pairs(c:GetChildren()) do if pt:IsA("BasePart") then pt.CanCollide = true end end end
                        StatusLbl.Text = "Trạng thái: Đã ghim Stand"; StatusLbl.TextColor3 = Color3.fromRGB(0,255,160)
                        showNotif("↩ r → Về hộ vệ!", Color3.fromRGB(180,255,200))
                    elseif lm == "s" then
                        S.StandState = "FollowMaster"; S.KillTargetChar = nil
                        StatusLbl.Text = "Trạng thái: Đã ghim Stand"; StatusLbl.TextColor3 = Color3.fromRGB(0,255,160)
                        showNotif("🔮 s → Triệu hồi!", Color3.fromRGB(180,140,255))
                    else
                        if #raw > 32 then return end
                        local found = findPlayerBySearch(raw)
                        if found then
                            task.spawn(function()
                                local tChar = getCharSafe(found)
                                if tChar then
                                    S.KillTargetChar = tChar; S.StandState = "Assassinating"
                                    StatusLbl.Text = "⚔ Tấn công: " .. found.DisplayName
                                    StatusLbl.TextColor3 = Color3.fromRGB(255, 78, 78)
                                    showNotif("⚔️ Tấn công: " .. found.DisplayName, Color3.fromRGB(255,100,100))
                                end
                            end)
                        end
                    end
                end)
            end)
        end
    end
    MasterDrop.CanvasSize = UDim2.new(0, 0, 0, cnt * 32)
end
SelectorBtn.MouseButton1Click:Connect(function()
